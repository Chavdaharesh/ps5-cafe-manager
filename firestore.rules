rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function cafeOwner() {
      return request.auth != null
        && request.auth.uid == "fERrZIKffsQYapVSWYmj4flTHuP2";
    }
    match /cafes/infinity-gaminig-cafe/{document=**} {
      allow read, write: if cafeOwner();
    }
  }
}
